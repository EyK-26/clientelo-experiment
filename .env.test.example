# Public, synthetic credentials for compose.test.yaml only. Never use on a hosted service.
# The owner is an administrator inside this disposable container for role/ACL tests.
APP_PROFILE=worksheet-qualification
APP_ENV=test
APP_DEBUG=false
APP_URL=https://native.clientelo.test
CSRF_TARGET_ORIGIN=https://native.clientelo.test
HOST=127.0.0.1
DATABASE_URL=postgres://clientelo_native_runtime:local-runtime-only@127.0.0.1:55432/clientelo_native_test
MIGRATION_DATABASE_URL=postgres://clientelo_native_test_owner:local-owner-only@127.0.0.1:55432/clientelo_native_test
RETENTION_DATABASE_URL=postgres://clientelo_native_retention_test:local-retention-only@127.0.0.1:55432/clientelo_native_test
RETENTION_TEST_FIXTURE=1
SESSION_SECRET=synthetic-local-session-secret-for-tests-only
AUTH_DEV_HEADERS=false
TENANT_DEV_HEADERS=false
FEATURE_REGISTRATION=false
WORKSHEET_CONTROLLED_TESTS=1
WORKSHEET_PUBLIC_COLLECTION=0
