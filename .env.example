# Product runtime only. Supply actual restricted credentials privately; no owner/admin/deletion URL.
APP_PROFILE=worksheet-product
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-product.example
CSRF_TARGET_ORIGIN=https://your-product.example
HOST=0.0.0.0
PORT=3000
DATABASE_URL=
SESSION_SECRET=
AUTH_DEV_HEADERS=false
TENANT_DEV_HEADERS=false
FEATURE_REGISTRATION=false
WORKSHEET_CONTROLLED_TESTS=0
WORKSHEET_PUBLIC_COLLECTION=0
# Keep release/retention flags absent until actual identity, legal and deletion-operation review.
# No SMTP/Resend setting is needed by the product. Nothing is emailed.
